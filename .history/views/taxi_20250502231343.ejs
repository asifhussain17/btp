<%- include("partials/header.ejs") %>

<h1 class="text-3xl font-bold text-gray-700 mt-4">Taxi Demand Prediction</h1>

<!-- Form -->
<form id="predictionForm" style="margin-bottom: 20px;">
    <label for="time">Time</label>
    <input type="time" id="time" name="time" required>
    <br><br>
    <button type="submit">Predict Demand</button>
</form>



<!-- Prediction result container -->
<div style="display: flex; justify-content: center; align-items: center; margin-bottom: 30px;">

    <div id="demandResult" style="font-size: 20px; font-weight: bold; color: #333;">
      Your content here
    </div>
  
</div>


<!-- Include this in your existing HTML file below the prediction result div -->
<canvas id="hourlyChart" max-width="800" max-height="400" style="margin-top: 40px;"></canvas>

<!-- Map container -->
<div id="map" style="width: 100%; height: 500px;"></div>

<!-- Mapbox JS and CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
    let sourceCoords = null;
    let destCoords = null;

    mapboxgl.accessToken = "<%= mapboxToken %>";

    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [-74.0060, 40.7128],
        zoom: 10,
        maxBounds: [
            [-74.2591, 40.4774],
            [-73.7004, 40.9176]
        ]
    });

    map.addControl(new mapboxgl.NavigationControl());

    let clickCount = 0;
    let markers = [];
    let routeLine = null;

    map.on('click', (e) => {
        const { lng, lat } = e.lngLat;

        if (clickCount === 0) {
            sourceCoords = { lat, lon: lng };
            const sourceMarker = new mapboxgl.Marker({ color: 'green' })
                .setLngLat([lng, lat])
                .addTo(map);
            markers.push(sourceMarker);
            clickCount++;
            alert('Source selected! Now click to select Destination.');

        } else if (clickCount === 1) {
            destCoords = { lat, lon: lng };
            const destMarker = new mapboxgl.Marker({ color: 'red' })
                .setLngLat([lng, lat])
                .addTo(map);
            markers.push(destMarker);
            clickCount++;

            drawRoute();
            alert('Destination selected! Now select time and click Predict.');
        } else {
            // Reset all
            markers.forEach(marker => marker.remove());
            markers = [];
            clickCount = 0;
            sourceCoords = null;
            destCoords = null;

            if (routeLine) {
                map.removeLayer('route');
                map.removeSource('route');
                routeLine = null;
            }

            alert('Selections reset. Start by clicking source.');
        }
    });

    function drawRoute() {
        if (!sourceCoords || !destCoords) return;

        const routeGeoJSON = {
            'type': 'Feature',
            'geometry': {
                'type': 'LineString',
                'coordinates': [
                    [sourceCoords.lon, sourceCoords.lat],
                    [destCoords.lon, destCoords.lat]
                ]
            }
        };

        if (map.getSource('route')) {
            map.removeLayer('route');
            map.removeSource('route');
        }

        map.addSource('route', {
            'type': 'geojson',
            'data': routeGeoJSON
        });

        map.addLayer({
            'id': 'route',
            'type': 'line',
            'source': 'route',
            'layout': {
                'line-join': 'round',
                'line-cap': 'round'
            },
            'paint': {
                'line-color': '#ff7e5f',
                'line-width': 4
            }
        });

        routeLine = routeGeoJSON;
    }

    document.getElementById("predictionForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!sourceCoords || !destCoords) {
            alert("Please select both source and destination by clicking on the map.");
            return;
        }

        const time = document.getElementById("time").value;

        try {
            const response = await fetch("http://127.0.0.1:5000/predict", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    sourceLat: sourceCoords.lat,
                    sourceLon: sourceCoords.lon,
                    destLat: destCoords.lat,
                    destLon: destCoords.lon,
                    time: time
                })
            });

            const data = await response.json();
            const resultDiv = document.getElementById("demandResult");
            resultDiv.innerHTML = `Predicted Taxi Demand: <span style="color: #007bff">${data.demand}</span>`;
        } catch (err) {
            console.error("Prediction failed:", err);
            alert("Prediction failed. Please try again.");
        }
    });
</script>





















<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    async function loadHourlyTrend() {
        if (!sourceCoords || !destCoords) {
            alert("Please select both source and destination on the map first.");
            return;
        }

        try {
            const res = await fetch("http://127.0.0.1:5000/hourly_demand", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    sourceLat: sourceCoords.lat,
                    sourceLon: sourceCoords.lon,
                    destLat: destCoords.lat,
                    destLon: destCoords.lon
                })
            });

            const data = await res.json();
            const hourlyData = data.hourly_demand;

            const ctx = document.getElementById("hourlyChart").getContext("2d");
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [...Array(24).keys()].map(h => `${h.toString().padStart(2, '0')}:00`),
                    datasets: [{
                        label: 'Hourly Taxi Demand',
                        data: hourlyData,
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.2)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        title: {
                            display: true,
                            text: 'Demand Variation Throughout the Day'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Demand'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Hour'
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error("Hourly trend fetch failed:", error);
            alert("Failed to load hourly trend.");
        }
    }
</script>

<!-- Button to trigger it -->
<div style="text-align: center; margin-top: 30px;">
    <button onclick="loadHourlyTrend()">Show Hourly Demand Trend</button>
</div>



</main>
</body> 
</html>
