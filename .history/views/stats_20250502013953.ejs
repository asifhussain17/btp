<%- include("partials/header.ejs") %>


<div id="controls">
    <label for="time">Select Time (HH:MM):</label>
    <input type="time" id="time" name="time" value="08:00" required />
    <button id="loadHeatmap">Load Heatmap</button>
</div>

<br/>

<div id="map" style="width: 100%; height: 500px;"></div>

<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>

<script>
mapboxgl.accessToken = "<%= mapboxToken %>";  // Replace with your Mapbox token

const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/dark-v10',
    center: [-73.935242, 40.730610],
    zoom: 10,
    maxBounds: [
    [-74.30, 40.50],
    [-73.65, 40.95]
        ]
});

map.on('load', () => {
    document.getElementById('loadHeatmap').addEventListener('click', async () => {
        const selectedTime = document.getElementById('time').value;

        try {
            const response = await fetch('http://localhost:5000/heatmap', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ time: selectedTime })
            });

            const data = await response.json();
            const heatmapData = data.points;

            console.log("Heatmap data received:", heatmapData);

            const geojson = {
                type: 'FeatureCollection',
                features: heatmapData.map(point => ({
                    type: 'Feature',
                    properties: { weight: point.weight },
                    geometry: {
                        type: 'Point',
                        coordinates: [point.lon, point.lat]
                    }
                }))
            };

            if (map.getSource('taxi-heatmap')) {
                map.removeLayer('taxi-heatmap');
                map.removeSource('taxi-heatmap');
            }

            map.addSource('taxi-heatmap', {
                type: 'geojson',
                data: geojson
            });

            map.addLayer({
                id: 'taxi-heatmap',
                type: 'heatmap',
                source: 'taxi-heatmap',
                maxzoom: 15,
                paint: {
                    'heatmap-weight': ['interpolate', ['linear'], ['get', 'weight'], 0, 0, 1, 1],
                    'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 0, 1, 15, 3],
                    'heatmap-color': [
                        'interpolate', ['linear'], ['heatmap-density'],
                        0, 'rgba(33,102,172,0)',
                        0.2, 'rgb(103,169,207)',
                        0.4, 'rgb(209,229,240)',
                        0.6, 'rgb(253,219,199)',
                        0.8, 'rgb(239,138,98)',
                        1, 'rgb(178,24,43)'
                    ],
                    'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 0, 5, 15, 20]
                }
            });

            console.log("Heatmap added.");

        } catch (err) {
            alert("Failed to load heatmap.");
            console.error(err);
        }
    });
});

</script>
</body>
</html>
