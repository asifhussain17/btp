<%- include("partials/header.ejs") %>

<h1>Taxi Demand Prediction</h1>

<!-- Map container -->
<div id="map" style="width: 100%; height: 500px;"></div>

<!-- Mapbox JS and CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>

<script>
    // Replace with your actual Mapbox token
    mapboxgl.accessToken = 'YOUR_MAPBOX_ACCESS_TOKEN';
    
    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [-74.0060, 40.7128], // NYC center
        zoom: 10,
        maxBounds: [
            [-74.2591, 40.4774], // Southwest coordinates (bottom-left)
            [-73.7004, 40.9176]  // Northeast coordinates (top-right)
        ]
    });

    // Optional: Add navigation control (zoom buttons)
    map.addControl(new mapboxgl.NavigationControl());
</script>

</main>
</body> 
</html>
