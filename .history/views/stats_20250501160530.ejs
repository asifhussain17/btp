<%- include("partials/header.ejs") %>
<div id="controls">
    <label for="time">Select Time (HH:MM):</label>
    <input type="time" id="time" name="time" value="08:00" required />
    <button id="loadHeatmap">Load Heatmap</button>
</div>
<div id="map"></div>

<script>
mapboxgl.accessToken = 'YOUR_MAPBOX_TOKEN';  // Replace with your Mapbox token

const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/dark-v10',
    center: [-73.935242, 40.730610],
    zoom: 10
});

document.getElementById('loadHeatmap').addEventListener('click', async () => {
    const selectedTime = document.getElementById('time').value;

    try {
        const response = await axios.post('http://localhost:5000/heatmap', {
            time: selectedTime
        });

        const heatmapData = response.data.points;

        const geojson = {
            type: 'FeatureCollection',
            features: heatmapData.map(point => ({
                type: 'Feature',
                properties: { weight: point.weight },
                geometry: {
                    type: 'Point',
                    coordinates: [point.lon, point.lat]
                }
            }))
        };

        if (map.getSource('taxi-heatmap')) {
            map.removeLayer('taxi-heatmap');
            map.removeSource('taxi-heatmap');
        }

        map.addSource('taxi-heatmap', {
            type: 'geojson',
            data: geojson
        });

        map.addLayer({
            id: 'taxi-heatmap',
            type: 'heatmap',
            source: 'taxi-heatmap',
            maxzoom: 15,
            paint: {
                'heatmap-weight': ['interpolate', ['linear'], ['get', 'weight'], 0, 0, 100, 1],
                'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 0, 1, 15, 3],
                'heatmap-color': [
                    'interpolate', ['linear'], ['heatmap-density'],
                    0, 'rgba(33,102,172,0)',
                    0.2, 'rgb(103,169,207)',
                    0.4, 'rgb(209,229,240)',
                    0.6, 'rgb(253,219,199)',
                    0.8, 'rgb(239,138,98)',
                    1, 'rgb(178,24,43)'
                ],
                'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 0, 2, 15, 20]
            }
        });

    } catch (err) {
        alert("Failed to load heatmap.");
        console.error(err);
    }
});
</script>
</body>
</html>
