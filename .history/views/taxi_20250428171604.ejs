<%- include("partials/header.ejs") %>

<h1>Taxi Demand Prediction</h1>

<!-- Form -->
<form id="predictionForm" method="POST" action="/predict" style="margin-bottom: 20px;">
    <label>Source Latitude:</label>
    <input type="text" id="sourceLat" name="sourceLat" readonly required>

    <label>Source Longitude:</label>
    <input type="text" id="sourceLon" name="sourceLon" readonly required>

    <br><br>

    <label>Destination Latitude:</label>
    <input type="text" id="destLat" name="destLat" readonly required>

    <label>Destination Longitude:</label>
    <input type="text" id="destLon" name="destLon" readonly required>

    <br><br>

    <label for="time">Time (24h format HH:MM):</label>
    <input type="time" id="time" name="time" required>

    <br><br>

    <button type="submit">Predict Demand</button>
</form>

<!-- Map container -->
<div id="map" style="width: 100%; height: 500px;"></div>

<!-- Mapbox JS and CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>

<script>
    mapboxgl.accessToken = "<%= mapboxToken %>";

    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [-74.0060, 40.7128],
        zoom: 10,
        maxBounds: [
            [-74.2591, 40.4774],
            [-73.7004, 40.9176]
        ]
    });

    map.addControl(new mapboxgl.NavigationControl());

    let clickCount = 0;
    let markers = [];

    map.on('click', (e) => {
        const lngLat = e.lngLat;

        if (clickCount === 0) {
            // First click → Source
            document.getElementById('sourceLat').value = lngLat.lat.toFixed(6);
            document.getElementById('sourceLon').value = lngLat.lng.toFixed(6);

            // Add marker
            const sourceMarker = new mapboxgl.Marker({ color: 'green' })
                .setLngLat([lngLat.lng, lngLat.lat])
                .addTo(map);

            markers.push(sourceMarker);

            clickCount++;
            alert('Source selected! Now select Destination by clicking again.');

        } else if (clickCount === 1) {
            // Second click → Destination
            document.getElementById('destLat').value = lngLat.lat.toFixed(6);
            document.getElementById('destLon').value = lngLat.lng.toFixed(6);

            const destMarker = new mapboxgl.Marker({ color: 'red' })
                .setLngLat([lngLat.lng, lngLat.lat])
                .addTo(map);

            markers.push(destMarker);

            clickCount++;
            alert('Destination selected! Now fill time and submit.');

        } else {
            // Already two points selected → reset if clicked again
            alert('You already selected Source and Destination. Resetting now...');
            markers.forEach(marker => marker.remove());
            markers = [];
            clickCount = 0;

            // Clear form
            document.getElementById('sourceLat').value = '';
            document.getElementById('sourceLon').value = '';
            document.getElementById('destLat').value = '';
            document.getElementById('destLon').value = '';
        }
    });
</script>

</main>
</body> 
</html>
