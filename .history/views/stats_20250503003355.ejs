<%- include("partials/header.ejs") %>


<div id="controls">
    <label for="time">Select Time</label>
    <input type="time" id="time" name="time" value="08:00" required />
    <button id="loadHeatmap">Load Heatmap</button>
</div>

<br/>


<!-- Form to get top demand zones -->
<form id="zoneForm" style="margin-top: 30px;">
    <label>Enter Time</label>
    <input type="time" id="zoneTime" value="08:00" required>
    <button type="submit">Get Top Demand Zones</button>
</form>

<div id="map" style="width: 100%; height: 500px;"></div>

<div id="zoneResult" style="margin-top: 20px;"></div>

<!-- Mapbox CSS/JS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>

<script>
mapboxgl.accessToken = "<%= mapboxToken %>";  // Replace with your Mapbox token

const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/dark-v10',
    center: [-73.935242, 40.730610],
    zoom: 8,
});

let markers = [];

map.on('load', () => {
    // Heatmap button handler
    document.getElementById('loadHeatmap').addEventListener('click', async () => {
        const selectedTime = document.getElementById('time').value;

        try {
            const response = await fetch('http://localhost:5000/heatmap', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ time: selectedTime })
            });

            const data = await response.json();
            const heatmapData = data.points;

            console.log(heatmapData);

            const geojson = {
                type: 'FeatureCollection',
                features: heatmapData.map(point => ({
                    type: 'Feature',
                    properties: { weight: point.weight },
                    geometry: {
                        type: 'Point',
                        coordinates: [point.lon, point.lat]
                    }
                }))
            };

            if (map.getSource('taxi-heatmap')) {
                map.removeLayer('taxi-heatmap');
                map.removeSource('taxi-heatmap');
            }

            map.addSource('taxi-heatmap', {
                type: 'geojson',
                data: geojson
            });

            map.addLayer({
                id: 'taxi-heatmap',
                type: 'heatmap',
                source: 'taxi-heatmap',
                maxzoom: 15,
                paint: {
                    'heatmap-weight': ['get', 'weight'],
                    'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 0, 1, 15, 2],
                    'heatmap-color': [
                        'interpolate',
                        ['linear'],
                        ['heatmap-density'],
                        0, 'rgba(33,102,172,0)',
                        0.1, 'rgb(103,169,207)',
                        0.3, 'rgb(209,229,240)',
                        0.5, 'rgb(253,219,199)',
                        0.7, 'rgb(239,138,98)',
                        1, 'rgb(178,24,43)'
                    ],
                    'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 0, 8, 15, 30],
                    'heatmap-opacity': 0.9
                }
            });

        } catch (err) {
            alert("Failed to load heatmap.");
            console.error(err);
        }
    });
});

// Handle top 5 zone form
document.getElementById('zoneForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    // Remove old markers
    markers.forEach(m => m.remove());
    markers = [];

    const time = document.getElementById('zoneTime').value;

    try {
        const res = await fetch('http://localhost:5000/top_demand_zones', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ time })
        });

        const zones = await res.json();

        const resultDiv = document.getElementById('zoneResult');
        resultDiv.innerHTML = '<h3>Top 5 Demand Zones:</h3>';

        zones.forEach((zone, index) => {
            resultDiv.innerHTML += `
                <p>#${index + 1}: <strong>${zone.place}</strong> <br>
                Demand: ${zone.demand}<br>
                Lat: ${zone.lat}, Lon: ${zone.lon}</p><hr>
            `;

            const marker = new mapboxgl.Marker({ color: 'orange' })
                .setLngLat([zone.lon, zone.lat])
                .setPopup(new mapboxgl.Popup().setText(`${zone.place}\nDemand: ${zone.demand}`))
                .addTo(map);

            markers.push(marker);
        });

    } catch (err) {
        console.error("Failed to fetch top zones:", err);
        alert("Could not fetch top demand zones.");
    }
});
</script>

</body>
</html>
